DATABASE_URL=postgres://review:review@localhost:5433/review
# Used by DB-backed tests (they TRUNCATE tables). Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgres://review:review@localhost:5433/review_test
WORKTREE_ROOT=/tmp/review-worktrees
CLAUDE_CLI_PATH=claude
# Claude Pro: run `claude auth login` on the host. Do not set ANTHROPIC_API_KEY
# (it overrides subscription auth and bills Console API usage).
COMPANION_FALLBACK_BRANCH=origin/develop
REVIEW_TIMEOUT_MS=120000
REQUIRE_DB=false
KNOWLEDGE_BASE_PATH=knowledge-base
# Local Ollama (docker compose) — EmbeddingGemma is 768-d
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=embeddinggemma
REPOS_JSON='[{"id":"be","role":"backend","localPath":"/repos/be","defaultBaseBranch":"develop","githubRepo":"org/be"},{"id":"fe","role":"frontend","localPath":"/repos/fe","defaultBaseBranch":"develop","githubRepo":"org/fe"}]'
# Teams webhook (required when REQUIRE_TEAMS=true)
REQUIRE_TEAMS=false
# Quote secrets that contain = or other special chars
TEAMS_WEBHOOK_SECRET=
# Power Automate HTTP trigger URL for Adaptive Card replies (Teams App path)
TEAMS_REPLY_FLOW_URL=
# Bot Framework OAuth alternative (leave empty when using TEAMS_REPLY_FLOW_URL)
TEAMS_BOT_APP_ID=
TEAMS_BOT_PASSWORD=
TEAMS_WEBHOOK_PORT=3080
MAX_CONCURRENT_REVIEWS=2
REVIEW_RETRY_MAX=2
GITHUB_TOKEN=
# Post COMMENT PR reviews from the Teams worker (requires GITHUB_TOKEN). Set false to disable.
GITHUB_REVIEW_DELIVERY=true
# ngrok (docker compose --profile tunnel). Get a token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Reserved domain (Teams webhook base). Default matches compose if unset.
NGROK_DOMAIN=primarily-live-stag.ngrok-free.app
