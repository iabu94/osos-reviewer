{
  "name": "@osos-reviewer/orchestrator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsx --env-file=../../.env src/cli.ts",
    "start:teams": "REQUIRE_TEAMS=true tsx --env-file=../../.env src/teams-cli.ts"
  },
  "dependencies": {
    "@osos-reviewer/code-intel": "*",
    "@osos-reviewer/knowledge": "*",
    "@osos-reviewer/db": "*",
    "@osos-reviewer/git-manager": "*",
    "@osos-reviewer/mcp-server": "*",
    "@osos-reviewer/shared": "*",
    "@osos-reviewer/teams": "*",
    "execa": "^9.5.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
