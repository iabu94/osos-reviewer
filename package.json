{
  "name": "cursor-review-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start:teams -w @review/orchestrator",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke:phase1": "bash ./scripts/smoke-phase1.sh",
    "smoke:phase2": "bash ./scripts/smoke-phase2.sh",
    "smoke:phase3": "bash ./scripts/smoke-phase3.sh",
    "smoke:phase4": "bash ./scripts/smoke-phase4.sh",
    "smoke:phase5": "bash ./scripts/smoke-phase5.sh",
    "smoke:phase6": "bash ./scripts/smoke-phase6.sh",
    "bench:phase6": "bash ./scripts/bench-phase6.sh"
  },
  "engines": {
    "node": ">=22"
  }
}
